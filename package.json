{
  "name": "@your-scope/my-plugin",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "A hello-world native Temps plugin",
  "author": "Your team",
  "repository": "https://github.com/your-org/your-plugin",
  "scripts": {
    "test": "bun test",
    "check": "tsc --noEmit",
    "build": "bun scripts/build.ts"
  },
  "dependencies": { "@temps-sdk/plugin": "0.1.0-beta.1" },
  "devDependencies": { "@types/bun": "1.3.3", "typescript": "5.9.3" },
  "temps": {
    "name": "my-plugin",
    "title": "My plugin",
    "category": "Development",
    "entrypoint": "src/index.ts",
    "screenshots": [
      {
        "path": "assets/plugin-light.png",
        "alt": "My plugin in light mode, showing its online status and hello-world API response",
        "caption": "The starter plugin running inside Temps in light mode."
      },
      {
        "path": "assets/plugin-dark.png",
        "alt": "My plugin in dark mode, showing its online status and hello-world API response",
        "caption": "The same plugin UI adapts to dark mode."
      }
    ],
    "platforms": ["linux-amd64-gnu", "linux-arm64-gnu", "linux-amd64-musl", "linux-arm64-musl", "darwin-amd64", "darwin-arm64"]
  }
}
